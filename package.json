{
  "name": "sqlglot-js",
  "version": "0.0.1",
  "description": "A zero-dependency JavaScript port of sqlglot (SQL parser, transpiler, and AST toolkit)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./dialects/*": "./src/dialects/*.js",
    "./dialects/*.js": "./src/dialects/*.js",
    "./expressions/index": "./src/expressions/index.js",
    "./expressions/index.js": "./src/expressions/index.js",
    "./contrib/gatewaySqlMetadata": "./contrib/gatewaySqlMetadata.js",
    "./contrib/gatewaySqlMetadata.js": "./contrib/gatewaySqlMetadata.js",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "contrib",
    "README.md",
    "LICENSE",
    "LICENSE-sqlglot",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test $(find test -name '*.test.mjs' | sort)",
    "check:types": "tsc --noEmit -p test/types/tsconfig.json"
  }
}
